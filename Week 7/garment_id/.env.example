# Host launch: export these variables in your shell. The app does not auto-load .env.
# Train/prepare models first with: uv run --frozen python scripts/train_models.py
GARMENT_ID_DEVICE=auto
GARMENT_ID_OFFLINE=0
GARMENT_ID_PORT=8000
# GARMENT_ID_MODEL_CACHE=/absolute/path/to/model-cache
# GARMENT_ID_DATA_CACHE=/absolute/path/to/data-cache
# GARMENT_ID_LOAD_MODEL=0  # UI-only development, never returns fake predictions
# GARMENT_ID_COG_URL=http://127.0.0.1:5002  # delegate to a running local Cog container
