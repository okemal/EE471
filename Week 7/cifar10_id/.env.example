# Host launch: export these variables in your shell. The app does not auto-load .env.
# Train/prepare models first with: uv run --frozen python scripts/train_models.py
CIFAR10_ID_DEVICE=auto
CIFAR10_ID_OFFLINE=0
CIFAR10_ID_PORT=8001
# CIFAR10_ID_MODEL_CACHE=/absolute/path/to/model-cache
# CIFAR10_ID_DATA_CACHE=/absolute/path/to/data-cache
# CIFAR10_ID_LOAD_MODEL=0  # UI-only development, never returns fake predictions
# CIFAR10_ID_COG_URL=http://127.0.0.1:5003  # delegate to a running local Cog container
