# Host launch: export these variables in your shell. The app does not auto-load .env.
# First start can download weights. Pre-download with scripts/download_models.py.
CAT_ID_DEVICE=auto
CAT_ID_OFFLINE=0
CAT_ID_WIKIPEDIA=1
CAT_ID_PORT=8000
# CAT_ID_MODEL_CACHE=/absolute/path/to/model-cache
# CAT_ID_LOAD_MODEL=0  # UI-only development, never returns fake predictions
